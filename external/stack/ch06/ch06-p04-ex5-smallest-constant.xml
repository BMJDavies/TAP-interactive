  <questionvariables><text><![CDATA[aa: rand([3, 4, 5, 6, 8]);
ta1: 1/2;
ta2: aa/2;
/* Diagnostic: sin x cos x taken to reach -1, so c = a. Distinct from ta2 because aa >= 3. */
dfull: aa;
s_assert(is(dfull # ta2 and ta2 + 1 # dfull), true);
]]></text></questionvariables>
