  <questionvariables><text><![CDATA[/* Base b = q^2 with q odd; b = 9 is the exercise. */
qb: rand([3, 5, 7, 9, 11]);
bb: qb^2;
ta1: qb^n;
validate_m(ex) := if equationp(ex) then "Type the expression for \\(m\\) only, without m = in front."
  else if setp(ex) or listp(ex) then "Type a single expression for \\(m\\), without brackets round it."
  else if not(every(lambda([v], member(v, [n])), listofvars(ex))) then "Use only the letter \\(n\\)."
  else if not(member(n, listofvars(ex))) then "Your \\(m\\) should depend on \\(n\\)."
  else if not(freeof(sqrt, ex)) then "Write \\(m\\) without a square root."
  else "";
/* Earlier results. All four are proved in the book; only one applies to m^2 - 1 with m odd. Correct third. */
optsR: [
 [rfour, false, "The sum of any two consecutive odd numbers is a multiple of 4."],
 [rcube, false, "The cube of any even number is a multiple of 8."],
 [rodd, true, "If \\(m\\) is odd, then \\(m^2 - 1\\) is a multiple of 8."],
 [rsix, false, "The product of any three consecutive integers is a multiple of 6."]
];
]]></text></questionvariables>
