  else if not(every(lambda([v], integerp(ev(v, simp)) and ev(v >= 0 and v <= 40, simp)), listify(ex))) then "Each remainder is a whole number from 0 to 40."
  else "";
ta1: 82;
ta2: {0, 1};]]></text></questionvariables>
