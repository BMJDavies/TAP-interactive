  <questionvariables><text><![CDATA[pp: rand([3, 5, 7, 11, 13]);
q1: 1 + pp;
q2: 1 + 2*pp;
/* ans1 uses insertstars 5 (single-letter variables), so 4ap reads as 4*a*p. */
validate_abp(ex) := if not(every(lambda([v], member(v, [a, b, p])), listofvars(ex))) then "Use only the letters a, b and p."
  else if not(polynomialp(ev(expand(ex), simp), [a, b, p])) then "Enter an expression in a, b and p without dividing by a letter. Put * before a bracket, as in a*(p + 1)."
  else "";
validate_quad(ex) := block([e],
  if not(every(lambda([v], is(v = n)), listofvars(ex))) then "Use only the letter n."
  else (e: ev(expand(ex), simp),
    if not(polynomialp(e, [n])) then "Enter a polynomial in n, such as 2*n^2 + 3*n + 5."
    else if not(is(hipow(e, n) = 2)) then "Enter a quadratic: the highest power of n must be 2."
    else if not(ev(integerp(coeff(e, n, 2)) and integerp(coeff(e, n, 1)) and integerp(coeff(e, n, 0)), simp)) then "Use whole-number coefficients."
    else ""));
ta1: 4*a*p + 4*a + 2*b + 1;
dcopy: a*p + 2*a + b + 1;
dmid: 4*a*p + 2*a + 2*b + 1;
dnoone: 4*a*p + 4*a + 2*b;
dwhole: ev(expand(p*ta1), simp);
ta2: ev(expand((n - 1)*(n - q1) + pp), simp);
val3t: pp*(2*pp + 1);]]></text></questionvariables>
