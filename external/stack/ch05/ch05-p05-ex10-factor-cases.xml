sq1: n^2 - n + 1;
sq2: n^2 + n + 1;
sq3: n^2 - n + 1;
sq4: n^2 + n + 1;
validate_factor(ex) := if some(lambda([ff], is(ev(expand(ex - ff), simp) = 0)), [n, n - 1, n + 1, n^2 + n + 1, n^2 - n + 1]) then ""
  else "Type one of the five factors: \\(n\\), \\(n - 1\\), \\(n + 1\\), \\(n^2 + n + 1\\) or \\(n^2 - n + 1\\).";
]]></text></questionvariables>
