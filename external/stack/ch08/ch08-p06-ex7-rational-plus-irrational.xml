  <questionvariables><text><![CDATA[okn(ex) := block([b, p, b0, p0],
  if atom(ex) then return(integerp(ex) or ex = %pi),
  if op(ex) = sqrt then (b: first(args(ex)), return(ratnump(ev(b, simp)))),
  if op(ex) = "^" then (b0: part(ex, 1), p0: part(ex, 2), b: ev(b0, simp), p: ev(p0, simp),
     return(ratnump(p) and ((ratnump(b) and (is(b >= 0) or oddp(denom(p)))) or (integerp(p) and okn(b0))))),
  if member(op(ex), ["+", "-", "*", "/"]) then return(every(okn, args(ex))),
  false);
validate_surd(ex) := if okn(ex) and freeof(%i, ev(ex, simp)) then "" else "Enter a real number built from whole numbers, fractions, square roots (or other roots) of whole numbers or fractions, and pi.";
qcanon(z) := ev(ratsimp(radcan(z)), algebraic:true, simp);
ta1: sqrt(2);
ta2: -sqrt(2);
ta3: [[f_sumirr, false, "The sum of two irrational numbers is irrational."],
      [f_prod, false, "The product of two rational numbers is rational."],
      [f_diff, true, "The difference of two rational numbers is rational."],
      [f_every, false, "Every real number is either rational or irrational."]];]]></text></questionvariables>
