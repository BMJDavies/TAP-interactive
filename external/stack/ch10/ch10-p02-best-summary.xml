      [w_square, false, "It squares \\(\\sqrt{9} = \\dfrac{a}{b}\\) wrongly: squaring should give \\(3 = \\dfrac{a^2}{b^2}\\), not \\(9 = \\dfrac{a^2}{b^2}\\)."],
      [w_claim, true, "It relies on the claim that if \\(a^2\\) is a multiple of 9 then \\(a\\) is a multiple of 9. That claim is false, so the contradiction is not proved."],
      [w_coprime, false, "It assumes that \\(a\\) and \\(b\\) have no common factor, but not every fraction can be written in that way."]];]]></text></questionvariables>
