  <questionvariables><text><![CDATA[ta1: 48;
ta2: 49*m - 6;
ta3: 5;
/* The chain 1, 3, 7, 15, ... is the numbers 2^j - 1: n is in it exactly when n + 1 is a power of 2. */
inchain(n) := block([pw], pw: 1, for i: 1 thru 5000 while pw < n + 1 do pw: 2*pw, is(pw = n + 1));
validate_int(ex) := block([vv], vv: ev(ex, simp), if integerp(vv) then "" else "Enter a whole number.");
validate_m(ex) := if member(safe_op(ex), ["=", "[", "{", "<", ">", "<=", ">=", "#"]) then "Type only the expression that goes in the bracket." else if op_usedp(ex, m) then "Type * between m and an opening bracket when you mean multiplication." else if freeof(m, ex) then "Use the induction hypothesis: your answer should contain m." else if every(lambda([v], is(v = m)), listofvars(ex)) then "" else "Write your answer in terms of m only.";
validate_posodd(ex) := block([vv], vv: ev(ex, simp), if integerp(vv) and vv >= 1 and oddp(vv) then "" else "Enter a positive odd whole number.");]]></text></questionvariables>
