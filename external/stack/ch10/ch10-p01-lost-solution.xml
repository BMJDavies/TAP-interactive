  <questionvariables><text><![CDATA[tmpl: rand([1, 2]);
pp: 2 + rand(8);
qq: rand_with_prohib(2, 9, [pp]);
claimed: if is(tmpl = 1) then qq else pp + qq;
errline: if is(tmpl = 1) then 3 else 2;
algline: if is(tmpl = 1) then 2 else 3;
eqn: if is(tmpl = 1) then (x^2 - pp*x = qq*x - pp*qq) else ((x - pp)^2 = qq*(x - pp));
chk: if is(tmpl = 1) then qq*(qq - pp) else qq^2;
ta1: errline;
ta2: pp;
validate_line5(ex) := block([vv], vv: ev(ex, simp), if integerp(vv) and vv >= 1 and vv <= 5 then "" else "Enter a line number from 1 to 5.");
validate_real(ex) := block([sv, fv], sv: ev(ex, simp), fv: errcatch(ev(bfloat(sv), simp)), if ratnump(sv) then "" else if is(fv = []) then "Enter a single real number, for example 3, -1/2 or sqrt(2)." else if bfloatp(first(fv)) then "" else "Enter a single real number, for example 3, -1/2 or sqrt(2).");
s_assert(is(pp # claimed) and is(errline # algline), true);]]></text></questionvariables>
