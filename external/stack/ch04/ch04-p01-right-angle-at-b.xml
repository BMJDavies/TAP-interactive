  <prt><name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle><feedbackvariables><text><![CDATA[/* AB = sa, BC = sb, AC = sc: the right angle at B is opposite AC, at A opposite BC, at C opposite AB. */
sa: ev(ans1, simp); sb: ev(ans2, simp); sc: ev(ans3, simp);
/* ispos and pythag are in the question variables: they survive very large lengths and forms that do not simplify exactly. */
sz: bfloat(abs(sa) + abs(sb) + abs(sc));
istri: ispos(sa, sz) and ispos(sb, sz) and ispos(sc, sz) and ispos(sa + sb - sc, sz) and ispos(sb + sc - sa, sz) and ispos(sa + sc - sb, sz);
atB: pythag(sa, sb, sc);
atA: pythag(sa, sc, sb);
atC: pythag(sb, sc, sa);
rightQ: atA or atB or atC;]]></text></feedbackvariables>
