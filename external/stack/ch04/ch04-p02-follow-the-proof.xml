  <questionvariables><text><![CDATA[nn: rand([13, 15, 21, 23, -7, -13]);
tk: (nn - 1)/2; dk: (nn + 1)/2;
tq: tk*(tk + 1)/2; dq: tk*(tk + 1);
partok: if mod(tk, 2) = 0 then kk else kk1;
parbad: if mod(tk, 2) = 0 then kk1 else kk;
ta1: tk;
ta2: [[kk, is(mod(tk, 2) = 0), "k"], [kk1, is(mod(tk, 2) = 1), "k + 1"]];
ta3: tq;
ta4: 3;
tk1: tk + 1;
nsq: nn^2 - 1;
s_assert(is(dk # tk and dq # tq and tk + 2 # dk and tq + 1 # dq), true);]]></text></questionvariables>
