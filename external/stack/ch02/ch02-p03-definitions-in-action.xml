  <questionvariables><text><![CDATA[/* Pool rows: [id, statement, truth, explanation], in three groups. */
poolEO: [
 ["EO1", "\\(0\\) is an even number.", true, "\\(0 = 2 \\times 0\\), and \\(0\\) is an integer, so \\(0\\) is even."],
 ["EO2", "\\(-7\\) is an odd number.", true, "\\(-7 = 2 \\times (-4) + 1\\), and \\(-4\\) is an integer, so \\(-7\\) is odd."],
 ["EO3", "\\(7\\) is even, because \\(7 = 2 \\times 3.5\\).", false, "To be even, \\(7\\) would have to be \\(2 \\times\\) (an integer), and \\(3.5\\) is not an integer. In fact \\(7 = 2 \\times 3 + 1\\), so \\(7\\) is odd."],
 ["EO4", "\\(2\\) is odd, because \\(2 = 2 \\times \\dfrac{1}{2} + 1\\).", false, "In the definition of odd, \\(k\\) must be an integer, and \\(\\dfrac{1}{2}\\) is not. \\(2 = 2 \\times 1\\), so \\(2\\) is even."]
];
poolDV: [
 ["DV1", "\\(4\\) divides \\(12\\).", true, "\\(12 = 4 \\times 3\\), and \\(3\\) is an integer."],
 ["DV2", "\\(12\\) divides \\(4\\).", false, "This would need \\(4 = 12 \\times q\\) for an integer \\(q\\), but \\(q\\) would be \\(\\dfrac{1}{3}\\). It is \\(4\\) that divides \\(12\\)."],
 ["DV3", "\\(5\\) divides \\(0\\).", true, "\\(0 = 5 \\times 0\\), and \\(0\\) is an integer. Every integer divides \\(0\\)."],
 ["DV4", "\\(-3\\) divides \\(12\\).", true, "\\(12 = (-3) \\times (-4)\\), and \\(-4\\) is an integer."],
 ["DV5", "\\(6\\) is a multiple of \\(12\\).", false, "The multiples of \\(12\\) are \\(12 \\times\\) (an integer): \\(0, 12, -12, 24, \\ldots\\) It is \\(12\\) that is a multiple of \\(6\\)."]
];
poolRA: [
 ["RA1", "\\(0.25\\) is a rational number.", true, "\\(0.25 = \\dfrac{1}{4}\\), a fraction with integer numerator and denominator."],
 ["RA2", "\\(\\sqrt{9}\\) is irrational.", false, "\\(\\sqrt{9} = 3 = \\dfrac{3}{1}\\), so \\(\\sqrt{9}\\) is rational."],
 ["RA3", "\\(-5\\) is a rational number.", true, "\\(-5 = \\dfrac{-5}{1}\\)."],
 ["RA4", "\\(\\pi\\) is rational, because \\(\\pi = \\dfrac{\\pi}{1}\\).", false, "In \\(\\dfrac{p}{q}\\), both \\(p\\) and \\(q\\) must be integers, and \\(\\pi\\) is not an integer. \\(\\pi\\) is irrational."],
 ["RA5", "Every integer is a rational number.", true, "Any integer \\(n\\) can be written as \\(\\dfrac{n}{1}\\)."]
];
/* One row from each group, one more from the 11 left, in a random order. */
rowEO: rand(poolEO);
rowDV: rand(poolDV);
rowRA: rand(poolRA);
poolleft: sublist(append(poolEO, poolDV, poolRA), lambda([rw], not(member(rw, [rowEO, rowDV, rowRA]))));
rowX: rand(poolleft);
qrows: random_permutation([rowEO, rowDV, rowRA, rowX]);
truths: map(third, qrows);
stm1: qrows[1][2]; tr1: qrows[1][3]; expl1: qrows[1][4];
stm2: qrows[2][2]; tr2: qrows[2][3]; expl2: qrows[2][4];
stm3: qrows[3][2]; tr3: qrows[3][3]; expl3: qrows[3][4];
stm4: qrows[4][2]; tr4: qrows[4][3]; expl4: qrows[4][4];
/* True before False in every row; unique tokens per row. */
ta1: [[t1, tr1, "True"], [f1, not tr1, "False"]];
ta2: [[t2, tr2, "True"], [f2, not tr2, "False"]];
ta3: [[t3, tr3, "True"], [f3, not tr3, "False"]];
ta4: [[t4, tr4, "True"], [f4, not tr4, "False"]];
cor1: if tr1 then t1 else f1; wrg1: if tr1 then f1 else t1;
cor2: if tr2 then t2 else f2; wrg2: if tr2 then f2 else t2;
cor3: if tr3 then t3 else f3; wrg3: if tr3 then f3 else t3;
cor4: if tr4 then t4 else f4; wrg4: if tr4 then f4 else t4;
labtf(tv) := if tv then "True." else "False.";
/* Part (b): divisible by p and by q, not by pq (p and q share a factor). */
pq: rand([[4,6],[6,10],[4,10],[6,9],[6,8],[10,15],[9,12]]);
pp: pq[1]; qq: pq[2];
tl: lcm(pp, qq);
ta5: tl;
s_assert(is(member(true, truths) and member(false, truths)), true);
s_assert(is(mod(tl, pp*qq) # 0), true);]]></text></questionvariables>
