ta1: tL; ta2: tS; ta3: 0;
/* Validation: the numerical input type rejects letters and decimals, but accepts i, inf, sets, lists, booleans and equations. This validator leaves only real numbers. */
validate_real(ex) := block([sv, fv], sv: ev(ex, simp), fv: errcatch(ev(bfloat(sv), simp)), if ratnump(sv) then "" else if is(fv = []) then "Enter a single real number, for example 3, -1/2 or sqrt(2)." else if bfloatp(first(fv)) then "" else "Enter a single real number, for example 3, -1/2 or sqrt(2).");
/* Options in a fixed order, the correct statement third. */
opts4: [
 [pic_all, false, "It proves the proposition for every real number \\(x\\)."],
 [pic_whole, false, "It proves the proposition only for whole numbers \\(x\\) greater than \\(1\\)."],
 [pic_big, true, "It proves the proposition for every real number \\(x\\) greater than \\(1\\)."],
 [pic_one, false, "It proves the proposition only for the value of \\(x\\) drawn in the picture."]
];]]></text></questionvariables>
