  <questionvariables><text><![CDATA[okn(ex) := block([b, p],
  if atom(ex) then return(integerp(ex) or ex = %pi),
  if op(ex) = sqrt then (b: first(args(ex)), return(ratnump(ev(b, simp)))),
  if op(ex) = "^" then (b: part(ex, 1), p: part(ex, 2),
     return(ratnump(ev(p, simp)) and (ratnump(ev(b, simp)) or (integerp(ev(p, simp)) and okn(b))))),
  if member(op(ex), ["+", "-", "*", "/"]) then return(every(okn, args(ex))),
  false);
validate_surd(ex) := if okn(ex) and freeof(%i, ev(ex, simp)) then "" else "Enter a real number built from whole numbers, fractions, square roots (or other roots) of whole numbers or fractions, and pi.";
qcanon(z) := ev(ratsimp(radcan(z)), algebraic:true, simp);
ta1: sqrt(2);
ta2: sqrt(8);]]></text></questionvariables>
