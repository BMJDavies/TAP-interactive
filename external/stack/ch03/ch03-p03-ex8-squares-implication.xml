  <questionvariables><text><![CDATA[ta1: -2;
ta2: 1;
/* validate_real: the numerical input accepts i, inf, sets, lists, booleans and equations; only a real number may reach the PRT. Same validator as Ch02_P01_Checks_are_not_a_proof. */
validate_real(ex) := block([sv, fv], sv: ev(ex, simp), fv: errcatch(ev(bfloat(sv), simp)), if ratnump(sv) then "" else if is(fv = []) then "Enter a single real number, for example 3, -1/2 or sqrt(2)." else if bfloatp(first(fv)) then "" else "Enter a single real number, for example 3, -1/2 or sqrt(2).");
/* nearzero: a numerical fallback for entries that do not simplify exactly, such as sin(1)^2+cos(1)^2 for 1. True when the size of z is less than 10^(-12) times the size of sc: z is 0 to within rounding error, on the scale sc. */
nearzero(z, sc) := block([fz, fs], fz: errcatch(ev(float(z), numer, simp)), fs: errcatch(ev(float(sc), numer, simp)), if is(fz = []) or is(fs = []) then return(false), fz: first(fz), fs: first(fs), if floatnump(fz) and floatnump(fs) then is(abs(fz) < 10^(-12)*abs(fs)) else false);
optsC: [[cconcl, false, "Alex's values make \\(x\\gt y\\) false, but a counterexample needs values that make \\(x\\gt y\\) true."],
  [cone, false, "One pair of values can never show that a statement about all real numbers is false."],
  [chyp, true, "Alex's values do not make \\(x^2\\gt y^2\\) true, so they do not test the statement: it only claims \\(x\\gt y\\) when \\(x^2\\gt y^2\\)."],
  [cnone, false, "Nothing is wrong: \\(x\\gt y\\) is false for Alex's values, so the statement is false."]];]]></text></questionvariables>
