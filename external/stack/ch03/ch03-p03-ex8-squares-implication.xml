    <name>prt1</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle>
    <feedbackvariables><text><![CDATA[sx: ev(ans1, simp);
sy: ev(ans2, simp);
/* The boundary x^2 = y^2 is tested first: exactly, then numerically for values that are not rational. */
eqsq: is(ev(ratsimp(radcan(sx^2 - sy^2)), algebraic:true, simp) = 0) or (not (ratnump(sx) and ratnump(sy)) and nearzero(sx^2 - sy^2, sx^2));
hyp: is(ev(sx^2 - sy^2, simp) > 0) and not eqsq;
concl: is(ev(sx - sy, simp) > 0);]]></text></feedbackvariables>
