  <prt>
    <name>prt5</name><value>1.0000000</value><autosimplify>1</autosimplify><feedbackstyle>1</feedbackstyle>
    <feedbackvariables><text><![CDATA[sa: ev(ans5, simp);
sb: ev(ans6, simp);
/* The zero test is exact, in canonical form, so that a zero such as (sqrt(2)+1)*(sqrt(2)-1)-1 is caught. */
zeroflag: is(ev(ratsimp(radcan(sa*sb)), algebraic:true, simp) = 0);
diffA: ev(expand((sa+sb)^3 - sa^3 - sb^3), simp);
/* With a and b both non-zero the equation holds exactly when a + b = 0. Exact test first; a pair that does not simplify exactly, such as sin(1)^2+cos(1)^2 and -1, is then compared numerically, relative to the size of a. Rational pairs are only compared exactly. */
holdsA: is(ev(ratsimp(radcan(diffA)), algebraic:true, simp) = 0) or (not (ratnump(sa) and ratnump(sb)) and nearzero(sa + sb, sa));]]></text></feedbackvariables>
