validate_q(ex) := block([sv], sv: ev(ex, simp), if fn_used(ex) then "Type * before an opening bracket when you mean multiplication, for example q*(x+y)." else if every(lambda([v], member(v, [x, y, k, q])), listofvars(ex)) then (if freeof(q, sv) then "Use the induction hypothesis: your answer should contain q." else if is(listofvars(ev(denom(ratsimp(sv)), simp)) = []) then "" else "Write the bracket without dividing by anything that contains x, y or q, so that it is clearly an integer.") else "Use only x, y, k and q.");]]></text></questionvariables>
