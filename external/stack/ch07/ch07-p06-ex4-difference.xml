ta2: m+(k+1)^2;
dfk1: expand(fk1);
fr: [6, 6*k+6, 6*k^2+6*k+6];
dm0: (k+1)^2;
dm6: 6*m+6*(k+1)^2;
/* Structural degree of an expression as written: a sum takes the largest of its terms, a product adds, a power multiplies. The simplified difference has structural degree 2. An answer of degree 3 or more still contains cubes that have not been cancelled. */
sdeg(ex) := block([oo], if numberp(ex) then return(0), if atom(ex) then return(1), oo: safe_op(ex), if is(oo = "+") then return(lmax(map(sdeg, args(ex)))), if is(oo = "*") then return(apply("+", map(sdeg, args(ex)))), if is(oo = "-") then return(sdeg(first(args(ex)))), if is(oo = "/") then return(sdeg(first(args(ex))) - sdeg(second(args(ex)))), if is(oo = "^") then return(if integerp(second(args(ex))) then second(args(ex))*sdeg(first(args(ex))) else sdeg(first(args(ex)))), 1);
validate_km(ex) := if every(lambda([v], member(v, [k, m])), listofvars(ex)) then "" else "Write your answer in terms of k and m.";
validate_k(ex) := if every(lambda([v], is(v = k)), listofvars(ex)) then "" else "Write your answer in terms of k only.";]]></text></questionvariables>
