  <questionvariables><text><![CDATA[trip: rand([[4,6,9],[7,3,9],[3,2,4],[5,4,8],[7,6,12],[9,8,16],[5,12,16]]);
aa: trip[1];
cc: trip[2];
dd: trip[3];
ta1: (aa-1)*aa^k + cc;
ta2: (aa-1)*cc;
dg1: aa + cc;
dg2: aa^k + cc;
dg3: aa*cc;
dg4: -ta2;
qq: ta2/dd;
h1: (aa-1)*aa + cc;
h1q: h1/dd;
s_assert(integerp(qq) and integerp(h1q), true);
validate_k(ex) := if every(lambda([v], is(v = k)), listofvars(ex)) then "" else "Write your answer in terms of k only.";
